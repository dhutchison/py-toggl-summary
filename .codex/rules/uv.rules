prefix_rule(pattern=["uv", "sync"], decision="allow")
prefix_rule(pattern=["uv", "lock"], decision="allow")
prefix_rule(pattern=["uv", "build"], decision="allow")
prefix_rule(pattern=["uv", "tree"], decision="allow")
prefix_rule(pattern=["uv", "run", "pytest"], decision="allow")
prefix_rule(pattern=["uv", "run", "ruff", "check"], decision="allow")
prefix_rule(pattern=["uv", "run", "ruff", "format"], decision="allow")
prefix_rule(pattern=["uv", "run", "mypy"], decision="allow")
prefix_rule(pattern=["uv", "run", "pre-commit", "install"], decision="allow")
prefix_rule(pattern=["uv", "run", "pre-commit", "run"], decision="allow")
